[Unit]
Description=Cloudflare tunnel for Ventoux radio HLS (named or quick fallback)
After=network-online.target ventoux-stream.service
Wants=network-online.target

[Service]
Type=simple
User=ventoux
WorkingDirectory=/opt/ventoux-watch
ExecStart=/opt/ventoux-watch/scripts/radio_tunnel_run.sh
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
